# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://zwauhiijhdyldwvoeiqr.supabase.co
# The "anon" (legacy) or "publishable" key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" (legacy) or "secret" key. Server-only, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Phase 7). A Gmail address and an App Password for it
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The public https address of the app, used for links in emails.
APP_URL=
# A long random string (e.g. `openssl rand -hex 32`). Supabase sends it to /api/cron/tick.
CRON_SECRET=
